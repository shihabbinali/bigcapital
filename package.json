{
  "name": "bigcapital-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "dev:webapp": "bun run --filter '@bigcapital/webapp' --filter '@bigcapital/utils' --filter '@bigcapital/pdf-templates' dev",
    "build:webapp": "bun run --filter '@bigcapital/webapp' --filter '@bigcapital/utils' --filter '@bigcapital/pdf-templates' build",
    "dev:server": "bun run --filter '@bigcapital/server' --filter '@bigcapital/utils' --filter '@bigcapital/pdf-templates' --filter '@bigcapital/email-components' dev",
    "build:server": "bun run --filter '@bigcapital/server' --filter '@bigcapital/utils' --filter '@bigcapital/pdf-templates' --filter '@bigcapital/email-components' build",
    "serve:server": "bun run --filter '@bigcapital/server' --filter '@bigcapital/utils' serve",
    "server:start": "bun run --filter '@bigcapital/server' start:dev",
    "test:watch": "bun run --filter '*' test:watch",
    "test:e2e": "bun run --filter '*' test:e2e",
    "start:debug": "bun run --filter '*' start:debug",
    "prepare": "husky install || true",
    "postinstall": "node scripts/patch-node-modules.js",
    "system:migrate:make": "bun run --filter '@bigcapital/server' cli:system:migrate:make",
    "tenants:migrate:make": "bun run --filter '@bigcapital/server' cli:tenants:migrate:make",
    "system:migrate:rollback": "bun run --filter '@bigcapital/server' cli:system:migrate:rollback",
    "tenants:migrate:rollback": "bun run --filter '@bigcapital/server' cli:tenants:migrate:rollback",
    "system:migrate:latest": "bun run --filter '@bigcapital/server' cli:system:migrate:latest",
    "tenants:migrate:latest": "bun run --filter '@bigcapital/server' cli:tenants:migrate:latest",
    "system:seed:latest": "bun run --filter '@bigcapital/server' cli:system:seed:latest",
    "tenants:seed:latest": "bun run --filter '@bigcapital/server' cli:tenants:seed:latest",
    "generate:sdk-types": "bun run --filter '@bigcapital/server' openapi:export && bun run --filter '@bigcapital/sdk-ts' generate && bun run --filter '@bigcapital/sdk-ts' build",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.2",
    "@commitlint/config-conventional": "^17.4.2",
    "@faker-js/faker": "^8.0.2",
    "@playwright/test": "^1.32.3",
    "husky": "^8.0.3"
  },
  "engines": {
    "node": "16.x || 17.x || 18.x"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "tsup": "^8.3.0"
  }
}
