# =============================================================================
# Bigcapital — Alwathba self-hosted environment template
# =============================================================================
# Copy to .env.alwathba and fill in real values before bringing the stack up:
#
#   cp .env.alwathba.example .env.alwathba
#   docker compose -f docker-compose.alwathba.yml --env-file .env.alwathba up -d --build
#
# IMPORTANT SECURITY NOTES
#   * APP_JWT_SECRET must be a long random string. The server reads this name
#     (NOT JWT_SECRET). Leaving the upstream JWT_SECRET name means the secret
#     silently defaults to "123123" — generate a strong value here.
#   * DB_PASSWORD / DB_ROOT_PASSWORD must be changed from the defaults below.
# =============================================================================

# --- Public proxy ------------------------------------------------------------
PUBLIC_PROXY_PORT=80
# If you run a TLS-terminating proxy in front, point BASE_URL at https://...

# --- Application -------------------------------------------------------------
# Public URL users reach the app through (no trailing slash).
BASE_URL=http://localhost

# --- Authentication ----------------------------------------------------------
# Generate with:  openssl rand -hex 48
APP_JWT_SECRET=change-me-to-a-long-random-secret

# --- Database ----------------------------------------------------------------
DB_USER=bigcapital
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_CHARSET=utf8
DB_PORT=3306

# --- System database ---------------------------------------------------------
SYSTEM_DB_NAME=bigcapital_system

# --- Tenant databases --------------------------------------------------------
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# --- Sign-up restrictions ----------------------------------------------------
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=

# --- Sign-up email confirmation ---------------------------------------------
SIGNUP_EMAIL_CONFIRMATION=false

# --- API throttling ----------------------------------------------------------
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=30

# --- Mail (SMTP) -------------------------------------------------------------
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM_NAME=Bigcapital
MAIL_FROM_ADDRESS=

# --- Gotenberg (leave as internal service URLs) ------------------------------
# These are overridden in the compose file; keep them here for reference only.
# GOTENBERG_URL=http://gotenberg:3000
# GOTENBERG_DOCS_URL=http://server:3000/public/

# --- Exchange rate -----------------------------------------------------------
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=

# --- Plaid (bank sync) -------------------------------------------------------
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=
BANK_FEED_ENABLED=false

# --- Lemon Squeezy -----------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- New Relic (optional) ----------------------------------------------------
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=false
NEW_RELIC_LOG=false
NEW_RELIC_AI_MONITORING_ENABLED=false
NEW_RELIC_CUSTOM_INSIGHTS_EVENTS_MAX_SAMPLES_STORED=0
NEW_RELIC_SPAN_EVENTS_MAX_SAMPLES_STORED=0
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=

# --- S3 (documents & attachments) -------------------------------------------
S3_REGION=US
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

# --- Stripe ------------------------------------------------------------------
STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=
